<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Light Theme Palette -->
    <Color x:Key="PageBackground">#F8FAFC</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="CardBorder">#E2E8F0</Color>
    <Color x:Key="InputBackground">#F1F5F9</Color>
    
    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryLight">#EEF2FF</Color>
    <Color x:Key="Secondary">#6366F1</Color>
    
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#94A3B8</Color>
    
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="SuccessLight">#ECFDF5</Color>
    
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

</ResourceDictionary>
